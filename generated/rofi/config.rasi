/* Generated by theme/build.lua */
/* Do not edit this file directly. */

* {
  bg: #202833;
  bg-alt: #28313d;
  fg: #d8dee9;
  muted: #7f8b99;
  accent: #8fbac8;

  font: "JetBrainsMono Nerd Font 10";
}

window {
  width: 42%;
  border: 1px;
  border-color: @accent;
  border-radius: 0px;
  background-color: @bg;
}

mainbox {
  background-color: @bg;
  padding: 14px;
}

inputbar {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0px;
  padding: 10px;
  margin: 0 0 12px 0;
}

prompt {
  text-color: @accent;
}

entry {
  text-color: @fg;
}

listview {
  background-color: @bg;
  lines: 8;
  columns: 1;
  spacing: 6px;
}

element {
  background-color: transparent;
  text-color: @fg;
  border-radius: 0px;
  padding: 8px;
}

element selected {
  background-color: @accent;
  text-color: @bg;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}
