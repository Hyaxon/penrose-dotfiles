/* Generated by theme/build.lua */
/* Do not edit this file directly. */

* {
  bg: #2e3440;
  bg-alt: #3b4252;
  fg: #eceff4;
  muted: #4c566a;
  accent: #88c0d0;

  font: "Inconsolata Nerd Font Mono 10";
}

window {
  width: 42%;
  border: 1px;
  border-color: @accent;
  border-radius: 0px;
  background-color: @bg;
}

mainbox {
  background-color: @bg;
  padding: 14px;
}

inputbar {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0px;
  padding: 10px;
  margin: 0 0 12px 0;
}

prompt {
  text-color: @accent;
}

entry {
  text-color: @fg;
}

listview {
  background-color: @bg;
  lines: 8;
  columns: 1;
  spacing: 6px;
}

element {
  background-color: transparent;
  text-color: @fg;
  border-radius: 0px;
  padding: 8px;
}

element selected {
  background-color: @accent;
  text-color: @bg;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}
