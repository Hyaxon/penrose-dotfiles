/*
 * Generated by theme/build.lua
 * Do not edit this file directly.
 * Edit the source template or theme file instead.
 */

* {
  bg: #0B111C;
  bg-alt: #111B2A;
  fg: #D8E3F0;
  muted: #61748D;
  accent: #D7193F;
  font: "Inconsolata Nerd Font Mono 10";
}

window {
  width: 42%;
  border: 1;
  border-color: @accent;
  border-radius: 0;
  background-color: @bg;
}

mainbox {
  background-color: @bg;
  padding: 14px;
  border: 0px;
}

inputbar {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0;
  padding: 10px;
  margin: 0 0 12px 0;
  border: 0px;
}

listview {
  background-color: @bg;
  lines: 8;
  columns: 1;
  spacing: 6px;
  border: 0px;
}

prompt {
  background-color: transparent;
  text-color: @accent;
}

entry {
  background-color: transparent;
  text-color: @fg;
}

element normal.normal {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0;
  padding: 8px;
}

element alternate.normal {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0;
  padding: 8px;
}

element selected.normal {
  background-color: @accent;
  text-color: @bg;
  border-radius: 0;
  padding: 8px;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
}

