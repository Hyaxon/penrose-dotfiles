/* Generated by theme/build.lua */
/* Do not edit this file directly. */

* {
  bg: #151515;
  bg-alt: #252C28;
  fg: #D3DAD5;
  muted: #67796D;
  accent: #D3DAD5;

  font: "Inconsolata Nerd Font Mono 10";
}

window {
  width: 42%;
  border: 1px;
  border-color: @accent;
  border-radius: 0px;
  background-color: @bg;
}

mainbox {
  background-color: @bg;
  padding: 14px;
  border: 0px;
}

inputbar {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0px;
  padding: 10px;
  margin: 0 0 12px 0;
  border: 0px;
}

listview {
  background-color: @bg;
  lines: 8;
  columns: 1;
  spacing: 6px;
  border: 0px;
}

prompt {
  background-color: transparent;
  text-color: @accent;
}

entry {
  background-color: transparent;
  text-color: @fg;
}

element normal.normal {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0px;
  padding: 8px;
}

element alternate.normal {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0px;
  padding: 8px;
}

element selected.normal {
  background-color: @accent;
  text-color: @bg;
  border-radius: 0px;
  padding: 8px;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
}
