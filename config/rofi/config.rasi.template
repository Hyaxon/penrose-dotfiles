* {
  bg: {{colors.bg}};
  bg-alt: {{colors.bg_alt}};
  fg: {{colors.fg}};
  muted: {{colors.muted}};
  accent: {{colors.accent}};
  font: "{{fonts.ui}} {{fonts.size}}";
}

window {
  width: {{rofi.width}};
  border: {{rofi.border_width}};
  border-color: @accent;
  border-radius: {{rofi.border_radius}};
  background-color: @bg;
}

mainbox {
  background-color: @bg;
  padding: 14px;
  border: 0px;
}

inputbar {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: {{rofi.border_radius}};
  padding: 10px;
  margin: 0 0 12px 0;
  border: 0px;
}

listview {
  background-color: @bg;
  lines: 8;
  columns: 1;
  spacing: 6px;
  border: 0px;
}

prompt {
  background-color: transparent;
  text-color: @accent;
}

entry {
  background-color: transparent;
  text-color: @fg;
}

element normal.normal {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: {{rofi.border_radius}};
  padding: 8px;
}

element alternate.normal {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: {{rofi.border_radius}};
  padding: 8px;
}

element selected.normal {
  background-color: @accent;
  text-color: @bg;
  border-radius: {{rofi.border_radius}};
  padding: 8px;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
}

